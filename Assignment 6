-- Display employees with their manager names
SELECT
    E.Empid,
    E.EmpName,
    E.Dep,
    E.Manager_ID,
    M.ManagerName
FROM Employee_Details E
JOIN Manager_Details M
ON E.Manager_ID = M.Manager_ID;
